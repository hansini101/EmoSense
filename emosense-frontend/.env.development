# EmoSense Frontend - Development Configuration

# Backend API URL for development
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Deployment URL (where frontend runs)
NEXT_PUBLIC_DEPLOYMENT_URL=http://localhost:3000

# Node environment
NODE_ENV=development

# Language support
NEXT_PUBLIC_SUPPORTED_LANGUAGES=en,si

# Default language
NEXT_PUBLIC_DEFAULT_LANGUAGE=en

# Authentication token keys (localStorage)
NEXT_PUBLIC_AUTH_TOKEN_KEY=auth_token
NEXT_PUBLIC_AUTH_USER_KEY=auth_user
NEXT_PUBLIC_AUTH_ROLE_KEY=auth_role

# Enable debug mode
NEXT_PUBLIC_DEBUG=true

# Feature flags for development
NEXT_PUBLIC_ENABLE_EMOTION_DETECTION=true
NEXT_PUBLIC_ENABLE_LUMA_AI=true
NEXT_PUBLIC_ENABLE_WELLNESS_HUB=true
NEXT_PUBLIC_ENABLE_ADMIN_PANEL=true

# Development server settings
# Port is automatically detected by Next.js
# If port 3000 is in use, Next.js will use 3001, 3002, etc.
