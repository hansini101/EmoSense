# EmoSense Frontend - Production Configuration

# API Base URL - Update this to your production backend domain
NEXT_PUBLIC_API_BASE_URL=https://api.emosense.com

# Next.js Configuration
NODE_ENV=production

# Enable analytics (optional)
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# Deployment URL
NEXT_PUBLIC_DEPLOYMENT_URL=https://emosense.com

# Language Support
NEXT_PUBLIC_SUPPORTED_LANGUAGES=en,si

# Authentication
NEXT_PUBLIC_AUTH_TOKEN_KEY=auth_token
NEXT_PUBLIC_AUTH_USER_KEY=auth_user
NEXT_PUBLIC_AUTH_ROLE_KEY=auth_role

# Session timeout (in milliseconds) - Optional
# NEXT_PUBLIC_SESSION_TIMEOUT=1800000

# Feature flags (optional)
NEXT_PUBLIC_ENABLE_EMOTION_DETECTION=true
NEXT_PUBLIC_ENABLE_LUMA_AI=true
NEXT_PUBLIC_ENABLE_WELLNESS_HUB=true
