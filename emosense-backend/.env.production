# EmoSense Backend - Production Configuration

# Django Settings
DEBUG=False
ALLOWED_HOSTS=api.emosense.com,emosense.com,www.emosense.com
SECRET_KEY=your-secret-key-here-generate-with-python-secrets-module

# Database Configuration
DB_ENGINE=django.db.backends.postgresql
DB_NAME=emosense_production
DB_USER=emosense_user
DB_PASSWORD=your-secure-password-here
DB_HOST=your-database-host.com
DB_PORT=5432

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://emosense.com,https://www.emosense.com,https://api.emosense.com
CORS_ALLOW_CREDENTIALS=True

# Email Configuration (for password resets, notifications)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password

# Static and Media Files
STATIC_URL=/static/
STATIC_ROOT=/var/www/emosense/static/
MEDIA_URL=/media/
MEDIA_ROOT=/var/www/emosense/media/

# Security Settings
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_BROWSER_XSS_FILTER=True
SECURE_CONTENT_SECURITY_POLICY=False
X_FRAME_OPTIONS=DENY

# Redis Cache (optional but recommended)
REDIS_URL=redis://your-redis-host:6379/1
CACHE_TTL=3600

# Logging
LOG_LEVEL=INFO
LOG_FILE=/var/log/emosense/django.log

# Application Settings
EMOTION_DETECTION_ENABLED=True
MAX_UPLOAD_SIZE=5242880
